{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [ "ES2020", "DOM", "DOM.Iterable" ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [ "jest", "node", "jquery" ],
    "baseUrl": ".",
    "paths": {
      "@self:playwright/*": [ "./tools/playwright/*" ]
    }
  },
  "include": [
    "src/assets/js/**/*",
    "tests/**/*",
  ],
  "exclude": [ "build", "node_modules", "vendor", "vendor_prefixed" ]
}
