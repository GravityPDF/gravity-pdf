#. translators: %s: option key name
#, php-format
msgid "The option key %s already exists. Use GPDFAPI::update_plugin_option instead"
msgstr ""
"Ключ опции %s уже существует. Вместо этого используйте "
"GPDFAPI::update_plugin_option"

#: api.php:479
msgid "Could not located the PDF Settings. Ensure you pass in a valid PDF ID."
msgstr ""
"Не удалось найти настройки PDF. Убедитесь, что вы ввели действительный "
"идентификатор PDF."

