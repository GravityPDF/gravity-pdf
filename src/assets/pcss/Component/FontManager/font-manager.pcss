
#tab_PDF {

	/* Settings Tab -> Default Font section -> Selector box */
	#gfpdf_settings\[default_font\],
 #gfpdf_settings\[font\] {
		margin: 0 0.2rem 0.2rem 0;
	}

	#gfpdf_pdf_form #gfpdf-settings-field-wrapper-font-container {
		display: flex;
	}
}

.gfpdf-font-manager-modal {

	.font-manager {
		overflow: hidden;

		.theme-about {
			background-color: #fff;
			bottom: 0;
			padding: 2% 4% 0% 4%;
		}

		#gfpdf-font-manager-container {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
			color: var(--gfpdf-default-text-color);

			.wp-filter-search {
				width: 60%;
			}

			.input-label-validation-error {
				border-color: var(--gfpdf-error-color);
			}

			/* Font list */
			.font-list-column {
				z-index: 2;
				background-color: #fff;

				.font-list {
					margin-top: 1rem;
					overflow: auto;
					max-height: 600px;
					box-shadow: 0 1px 1px rgba(0, 0, 0, 0.04);

					.alert-message {
						border: 0;
						text-align: center;
						margin: 40px 0;
						box-shadow: unset;

						.link {
							color: var(--gfpdf-link-color);
							cursor: pointer;
							text-decoration: underline;
						}

						button.link {
							background-color: unset;
							border: unset;
							box-shadow: unset;
							text-decoration: underline;
							color: var(--gfpdf-link-color);
							padding: 0;

							&:hover {
								cursor: pointer;
							}
						}
					}

					.font-list-header,
					.font-list-item {
						display: grid;
						grid-template-columns: 4fr 1.5fr 1.5fr 1.5fr 2fr 0.75fr;
						gap: 1rem;
						padding: 0.325rem 0;
						text-align: center;

						.font-name {
							text-align: left;
							word-break: break-all;

							.select-font-name {
								width: 1rem;
								height: 1rem;
								margin-right: 0.5rem;
							}
						}
					}

					.font-list-header {
						font-weight: 600;
					}

					.font-list-items {

						.font-list-item {
							border-top: 1px solid var(--gfpdf-lighter-highlight-color);

							&:hover {
								cursor: pointer;
								background: var(--gfpdf-lighter-highlight-color);
							}

							&.active {
								background-color: var(--gfpdf-lighter-highlight-color);
							}

							&:focus {
								border: 1px dotted var(--gfpdf-highlight-color);
							}
						}

						/* Icons */
						.dashicons-trash {
							color: var(--gfpdf-highlight-color);
							text-align: center;
							transition: color 0.25s ease;
							margin-left: 5px;

							&:focus,
							&:hover {
								color: var(--gfpdf-error-color);
							}
						}

						.dashicons-yes,
						.dashicons-no-alt {
							font-size: 22px;
						}

						.dashicons-yes {
							color: var(--gfpdf-success-color);
						}

						.dashicons-no-alt {
							color: var(--gfpdf-highlight-color);
						}
					}
				}
			}

			/* Add font */
			.add-update-font-column {
				display: flex;
				position: relative;
				width: 100%;

				#gfpdf-add-font-name-input,
				#gfpdf-update-font-name-input {
					width: 100%;
				}

				.add-font {
					width: 79%;
					margin-left: 1px;
				}

				.update-font {
					background-color: #fff;
					padding-right: 0.5rem;
					width: 80%;
				}

				h2 {
					font-size: 1.8em;
					margin: 0.5rem 0;

					& + p {
						margin: 0;
					}
				}

				label {
					display: block;
					margin-top: 1rem;
					font-size: 1rem;
					font-weight: 600;

					& + p {
						margin: 0.325rem 0;
					}
				}

				.required {
					color: var(--gfpdf-validation-error-color);
					font-size: 0.8rem;
				}

				#gfpdf-font-files-setting {
					display: grid;
					grid-template-columns: 50% 50%;
					grid-template-rows: 1fr 1fr;
					gap: 1rem;
					margin: 0.75rem 0;
					width: 96%;

					a {
						color: unset;

						&:focus {
							box-shadow: unset;
						}
					}

					/* FormFileUpload wraps its render output in a <div>; collapse it
             so the inner .drop-zone anchor remains the grid item. */
					.components-form-file-upload {
						display: contents;
					}

					.drop-zone {
						position: relative;
						display: flex;
						flex-direction: column;
						align-items: center;
						justify-content: center;
						border: 5px dashed var(--gfpdf-lighter-highlight-color);
						height: 160px;
						transition: all 0.3s ease-out;

						&:hover,
						&.active {
							background-color: var(--gfpdf-lighter-highlight-color);
							border: 5px solid var(--gfpdf-lighter-highlight-color);

							.dashicons {
								background-color: #fff;
								color: var(--gfpdf-highlight-color);
							}
						}

						&:focus {
							outline: none;
							border: 5px dashed var(--gfpdf-default-text-color);
						}

						&.required {
							border: 5px dashed var(--gfpdf-error-color);

							.dashicons {
								background-color: var(--gfpdf-error-color);
								color: #fff;
							}

							&:focus {
								border-color: var(--gfpdf-default-text-color);
							}
						}

						&.error {
							background-color: var(--gfpdf-validation-error-color);
							border-color: var(--gfpdf-validation-error-color);
							color: #fff;
						}

						.gfpdf-font-filename {
							overflow: hidden;
							text-align: center;

							&.required {
								color: var(--gfpdf-validation-error-color);
							}
						}

						.dashicons {
							width: 70px;
							height: 70px;
							margin: 0.675rem;
							background-color: var(--gfpdf-lighter-highlight-color);
							border-radius: 50%;
							font-size: 3.2rem;
							color: var(--gfpdf-highlight-color);
							cursor: pointer;

							&::before {
								margin-left: -1px;
								vertical-align: middle;
							}
						}

						.dashicons-trash {
							font-size: 2.9rem;

							&::before {
								margin-left: 3px;
							}
						}
					}
				}
			}
		}
	}
}
