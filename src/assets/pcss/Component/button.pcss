
#tab_PDF {

  .button:not(.wp-editor-wrap .button):not(.wp-picker-container .button) {
    font-size: 0.9rem;
    padding: 0 0.75rem;
    height: auto;
    line-height: 2.54545455;
    line-height: 2.95;

    &:not(.primary):hover {
      border-color: unset;
      background-color: unset;
    }
  }

  /* Template and Font Manager Advanced Button */
  #gfpdf-template-container, #gfpdf-font-manager-container {
    display: inline-block;
    vertical-align: top;

    button {
      font-size: 0.9rem;
      padding: 0 0.75rem;
      height: auto;
      line-height: 2.54545455;
      min-height: 32px;
      line-height: 2.30769231;

      &.primary:hover {
        background: #242748;
        border-color: #242748;
      }
    }
  }
}
