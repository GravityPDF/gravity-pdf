/**
 * RTL overrides for the Font Manager modal.
 *
 * The new layout is built on @wordpress/components which already
 * RTL-mirrors most of its primitives — these rules only flip the few
 * Font-Manager-specific affordances that have explicit left/right values.
 */

html[dir="rtl"] {
	#tab_PDF {
		#gfpdf_settings\[default_font\],
		#gfpdf_settings\[font\] {
			margin: 0 0 0.2rem 0.2rem;
		}
	}
}

html[dir="rtl"] .gfpdf-font-manager-modal {
	.gfpdf-fm-sidebar {
		border-right: 0;
		border-left: 1px solid var(--gfpdf-lighter-highlight-color);
	}

	.gfpdf-fm-row {
		border-left: 0;
		border-right: 3px solid transparent;
	}

	.gfpdf-fm-row.is-selected {
		border-right-color: #3858e9;
	}

	.gfpdf-fm-row__active-bar {
		left: auto;
		right: 0;
		border-radius: 2px 0 0 2px;
	}

	.gfpdf-fm-variant-row.is-drag-over {
		box-shadow: inset 0 0 0 2px #3858e9;
	}

	.gfpdf-fm-detail-footer .gfpdf-fm-delete-button {
		order: -1;
	}
}
